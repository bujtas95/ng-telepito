// Kinyerési profil: Rollotop (Lendvai és Társa Kft.) árlista, a 2026-os kiadás elrendezése alapján.
// A táblázatokat a fejlécük alapján keresi, nem oldalszám szerint, így egy új kiadásnál is használható.
// x koordináták: PDF pont, a bal szélétől (A4 = 595 pt széles).
{
  "name": "Rollotop",
  // A termékek főkategóriája; az alkategória a profil neve (Rollotop).
  "category": "Medencefedések",
  "currency": "HUF",
  "tableOfContentsPage": 3,
  // A táblák alatti „Telepítési költség…” blokk: a km-sávok a telepítés ára, a többi sor (felár) választható.
  "installation": {
    "context": "^Telepítési költség",
    "tierLabel": "(?<upTo>\\d+)\\s*km",
    "inputKey": "distance_km",
    "inputLabel": "Távolság Pilisszentivántól",
    "unit": "km"
  },
  "tables": [
    {
      "key": "vf1",
      "name": "VF1 Standard – komplett roló lamellával",
      "code": "VF1",
      "heading": "^VF1 - Rollotop",
      "endAbove": "keresztbe takarva",
      "groupAxis": { "key": "width", "label": "Szélesség", "unit": "m", "xMin": 40, "xMax": 70 },
      "rowAxis": { "key": "length", "label": "Hossz", "unit": "m", "xMin": 85, "xMax": 100 },
      "columnAxisKey": "slat",
      "columnAxisLabel": "Lamella",
      "columns": [
        { "key": "pvc", "label": "PVC" },
        { "key": "pc_transparent", "label": "Polikarbonát áttetsző" },
        { "key": "pc_solar", "label": "Polikarbonát szolár" },
        { "key": "elite", "label": "Elite" }
      ],
      // 17. oldal: a lamella m²-ára; a szélességet 0,5 m-re felfelé kell kerekíteni.
      "step": {
        "formula": "ceil_to(width, 0.5) * rate",
        "rates": { "pvc": 34860, "pc_transparent": 62250, "pc_solar": 62250, "elite": 66400 },
        "source": "17. oldal, Rolólamellák ára"
      }
    },
