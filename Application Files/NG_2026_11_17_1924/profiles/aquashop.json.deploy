// Kinyerési profil: Aquashop Kft. magyar katalógus, a 2026-os kiadás elrendezése alapján.
// A cikktáblákat a „Nettó ár … Bruttó ár” fejlécük alapján keresi, nem oldalszám szerint.
// Egy cikksor: cikkszám, árcsoport (A–D), megnevezés, további oszlopok (csomag, tömeg, méretek), nettó és bruttó ár.
// A bruttó ár a nettó 27% áfával, 100 Ft-ra kerekítve; ahol nem így van, az ár ellenőrzésre vár.
// A „groups”, „names” és „categories” rész a 2026-os kiadás tartalmi átnézéséből jön: melyik cikk melyik termék
// változata, mely nevek voltak hibásak a PDF-ben, és mely táblák kategóriája nem az oldal fejléce. Az árakat nem érinti.
// A kategória a katalógus fejezete (főkategória, pl. Szkimmerek); a termékcsalád az alkategória. A „chapters” oldaltartomány
// szerint adja a főkategóriát, a „mainCategories” név szerint (ahol a fejezet mást adna, pl. a szkimmerek a befalazó elemek között).
{
  "name": "Aquashop",
  "currency": "HUF",
  "tables": [],
  "articles": {
    "articleNumber": "^\\d{6}(-[0-9A-Z]{1,4})?$",
    "priceGroup": "^[A-D]$",
    "vatRate": 0.27,
    "grossRounding": 100,
    "defaultUnit": "db",
    "units": {
      "m": "m",
      "m2": "m²",
      "m²": "m²",
      "fm": "m",
      "db": "db",
      "kg": "kg",
      "l": "l",
      "forint": "db",
      "Ft": "db"
    },
